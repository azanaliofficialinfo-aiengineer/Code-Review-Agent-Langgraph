# ── Frontend environment variables ───────────────────────────────────────────
#
# IMPORTANT: NEXT_PUBLIC_* variables are embedded at BUILD TIME.
# They must be set BEFORE running `npm run build` or `docker build`.
#
# For docker-compose: set them under `build.args` in docker-compose.yml.
# For Railway/cloud:  set them as build-time environment variables in the
#                     platform dashboard before the first deploy.

# Backend API base URL — the URL the BROWSER uses to reach the FastAPI backend.
#
#   Local dev (npm run dev):        http://localhost:8000
#   Local docker-compose:           http://localhost:8000  (browser accesses host)
#   Production (Railway / Render):  https://your-backend.railway.app
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional bearer token for API authentication.
# Leave empty in development when API_AUTH_ENABLED=false on the backend.
# In production, must match the backend API_AUTH_TOKEN setting.
NEXT_PUBLIC_API_AUTH_TOKEN=
