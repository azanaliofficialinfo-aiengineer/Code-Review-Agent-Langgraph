# Application
APP_NAME=CodeReview Agent
ENVIRONMENT=development

# Database (matches docker-compose service name)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/codereview

# Redis (matches docker-compose service name)
REDIS_URL=redis://redis:6379

# GitHub App — create at https://github.com/settings/apps/new
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
GITHUB_APP_ID=your_github_app_id
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# AI Providers
GROQ_API_KEY=your_groq_api_key_here
AI_PROVIDER=groq

# API Authentication
# In production, auth is always enforced; set a strong random token.
API_AUTH_ENABLED=false
API_AUTH_TOKEN=

# CORS
# Comma-separated list of allowed frontend origins.
# Development: localhost:3000 is always allowed; this setting is optional.
# Production: REQUIRED — startup fails if empty when ENVIRONMENT=production.
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Set to false if you do not use cookies/session auth (bearer-token only is fine with false).
ALLOW_CREDENTIALS=true
